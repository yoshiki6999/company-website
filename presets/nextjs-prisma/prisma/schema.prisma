// Prisma Schema for Next.js + Neon Project
// Database: PostgreSQL (Neon)
// Documentation: https://prisma.io/docs/orm/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== Base Tables (System) ==========
// DO NOT modify this section unless explicitly agreed upon

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

