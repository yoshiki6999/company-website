# ===========================================
# Environment Variables Template
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT:
# - .env is in .gitignore — NEVER commit it
# - Use DEVELOPMENT values locally
# - Production values go in GitHub Secrets / platform env vars
# ===========================================

# === Server ===
PORT=5000
NODE_ENV=development

# === Database ===
# Choose ONE database provider and uncomment the relevant lines.
# Use DEVELOPMENT database credentials here, NOT production.

# Option A: Neon PostgreSQL (recommended — supports branching)
# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require

# Option B: Supabase
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_KEY=eyJ...

# Option C: Vercel Postgres
# POSTGRES_URL=postgres://...

# Option D: Turso (LibSQL)
# TURSO_DATABASE_URL=libsql://xxx.turso.io
# TURSO_AUTH_TOKEN=eyJ...

# Option E: Generic PostgreSQL
# DATABASE_URL=postgresql://user:pass@localhost:5432/mydb_dev

# === Authentication ===
# SESSION_SECRET=generate-a-random-string-here
# JWT_SECRET=generate-another-random-string-here

# === AI Services ===
# Uncomment the services you use

# Google Gemini
# GEMINI_API_KEY=

# Anthropic Claude
# ANTHROPIC_API_KEY=

# OpenAI
# OPENAI_API_KEY=

# === Deployment Platform ===
# These are auto-injected by the platform — only set if needed locally

# Railway
# RAILWAY_PUBLIC_DOMAIN=

# Vercel
# VERCEL_URL=

# === External Services ===
# Add any other API keys or service URLs below

# === Internal ===
# API key for internal service-to-service calls (if applicable)
# API_KEY=generate-a-secure-key-here
